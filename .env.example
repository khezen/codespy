# codespy Configuration
# Copy this file to .env and fill in your values
#
# NOTE: For advanced configuration (per-signature settings, model overrides),
# use codespy.yaml instead. See codespy.yaml for full options.
# Priority: Environment Variables > YAML Config > Defaults
#
# Environment variables follow the YAML path, uppercased and joined with _.
# The llm., memory.hippocampus., memory.cerebral. and memory.prefrontal.
# segments are dropped; llm.retries, llm.timeout and memory.prefrontal.reflects
# keep their full names.

# =============================================================================
# Git Platform Tokens
# =============================================================================

# GitHub Token
# Create a token at: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos only)
# Auto-discovered from: gh CLI, git credential helper, ~/.netrc, $GITHUB_TOKEN, $GH_TOKEN
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Disable GitHub token auto-discovery (default: true)
# GITHUB_AUTO_DISCOVER_TOKEN=false

# GitLab Token (for GitLab MRs)
# Create a token at: https://gitlab.com/-/profile/personal_access_tokens
# Required scopes: api (for full access) or read_api + write_repository
# Auto-discovered from: glab CLI, git credential helper, ~/.netrc, ~/.python-gitlab.cfg
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# GITLAB_URL=https://gitlab.com
# Disable GitLab token auto-discovery (default: true)
# GITLAB_AUTO_DISCOVER_TOKEN=false

# =============================================================================
# LLM Configuration (choose one provider)
# =============================================================================

# Default model identifier (LiteLLM format)
# Examples:
#   - anthropic/claude-opus-4-6                       (Anthropic direct)
#   - anthropic/claude-sonnet-4-5-20250929            (Anthropic direct)
#   - bedrock/us.anthropic.claude-opus-4-6-v1         (AWS Bedrock)
#   - bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0 (AWS Bedrock)
#   - bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0  (AWS Bedrock)
#   - openai/gpt-5                                    (OpenAI)
#   - openai/gpt-4-turbo                              (OpenAI)
#   - gemini/gemini-2.5-pro                           (Google Gemini)
#   - gemini/gemini-2.5-flash                         (Google Gemini)
#   - ollama/llama-4-70b                              (Local Ollama)
DEFAULT_MODEL=bedrock/converse/nvidia.nemotron-nano-3-30b

# ------------------------------------------------------------------------------
# Option 1: Anthropic (direct)
# ------------------------------------------------------------------------------
# Auto-discovered from: $ANTHROPIC_API_KEY, ~/.config/anthropic/, ~/.anthropic/
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Option 2: AWS Bedrock
# ------------------------------------------------------------------------------
# Auto-discovered from: ~/.aws/credentials, AWS CLI, $AWS_ACCESS_KEY_ID
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_PROFILE=default

# ------------------------------------------------------------------------------
# Option 3: OpenAI
# ------------------------------------------------------------------------------
# Auto-discovered from: $OPENAI_API_KEY, ~/.config/openai/, ~/.openai/
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Option 4: Google Gemini
# ------------------------------------------------------------------------------
# Auto-discovered from: $GEMINI_API_KEY, $GOOGLE_API_KEY, gcloud ADC
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Option 5: Azure OpenAI
# ------------------------------------------------------------------------------
# AZURE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2024-02-15-preview

# =============================================================================
# Auto-Discovery Settings
# =============================================================================
# Disable auto-discovery for specific providers (all default to true)
# AUTO_DISCOVER_OPENAI=false
# AUTO_DISCOVER_ANTHROPIC=false
# AUTO_DISCOVER_GEMINI=false
# AUTO_DISCOVER_AWS=false

# =============================================================================
# Recommended Model Strategy
# =============================================================================
# codespy uses a tiered model approach to balance review quality and cost:
#
#   Smart (per-signature pinned): Core analysis — code review (bugs, security, smells),
#     supply chain, scope identification, doc review. Requires strong reasoning.
#     Default: bedrock/converse/global.anthropic.claude-opus-5-5 (via per-signature pins).
#
#   Mid-tier (EXTRACTION_MODEL): Structured field extraction. Needs accuracy
#     but not deep reasoning. Default: bedrock/converse/nvidia.nemotron-nano-3-30b
#
#   Cheap (REVIEW_SUMMARY_MODEL): PR summary generation. Simple synthesis.
#     Default: bedrock/converse/nvidia.nemotron-super-3-120b
#
#   Mid-tier (MEMORY_DISTILLER_MODEL / MEMORY_CARTOGRAPHER_MODEL):
#     Memory reflection — summarizing a trajectory and curating the context memory.
#     Requires nuance.
#     Default: bedrock/converse/nvidia.nemotron-super-3-120b
#
# By default, all models are pinned. To override a specific unit, set its
# per-signature or per-memory env var. To re-enable the fallback chain, set the
# pinned unit to null: REVIEW_CODE_REVIEW_MODEL=null uses DEFAULT_MODEL.
#
# New defaults require AWS Bedrock access to Opus 5.5 and both Nemotron models.
# Override every model if using Anthropic-only, OpenAI-only, or Gemini-only.


# =============================================================================
# Default Settings
# =============================================================================
# These apply to all signatures unless overridden per-signature

# Extraction model for TwoStepAdapter
# EXTRACTION_MODEL=bedrock/converse/nvidia.nemotron-nano-3-30b

# DEFAULT_MAX_ITERS=5
# DEFAULT_MAX_LLM_CALLS=8
# Provider reasoning budget: minimal | low | medium | high
# DEFAULT_REASONING_EFFORT=medium
# DEFAULT_TEMPERATURE=1.0
# Output token budget for a single completion (default: 32000)
# DEFAULT_MAX_TOKENS=32000

# Global LLM reliability settings
# LLM_RETRIES=2
# LLM_TIMEOUT=240

# =============================================================================
# RLM Fallback (Context Rot Prevention)
# =============================================================================
# RLM_FALLBACK_ENABLED=true
# RLM_FALLBACK_REACT_THRESHOLD=0.30
# RLM_FALLBACK_CHAIN_OF_THOUGHT_THRESHOLD=0.40
# RLM_FALLBACK_PREDICT_THRESHOLD=0.50


# =============================================================================
# Minimum Confidence
# =============================================================================
# REVIEW_MIN_CONFIDENCE=0.81


# =============================================================================
# Memory (Hippocampus)
# =============================================================================
# Hippocampus lets scope-based agents consolidate their run into a ContextMemory
# and persist it as an Episode. Episodes are stored in PostgreSQL.
#
# Production uses MEMORY_POSTGRES_HOST (+ credentials) to connect to an
# external PostgreSQL instance (AWS RDS, etc.). For local development,
# pg0-embedded is used if MEMORY_POSTGRES_HOST is not set.

# PostgreSQL connection
# MEMORY_POSTGRES_HOST=rds-host.amazonaws.com
# MEMORY_POSTGRES_PORT=5432
# MEMORY_POSTGRES_USER=myuser
# MEMORY_POSTGRES_PASSWORD=mypassword
# MEMORY_POSTGRES_DATABASE=codespy

# Bank ID — nickname, username, email, or agent name scoping all memory data.
# When unset, defaults to "codebase".
# MEMORY_BANK_ID=my-agent

# pg0 embedded settings (local dev only)
# MEMORY_PG0_NAME=codespy
# MEMORY_PG0_PORT=5433
# MEMORY_PG0_DATA_DIR=~/.cache/codespy/pg0

# Memory master switch — overridable per-signature via REVIEW_<SIG>_MEMORY_ENABLED
# MEMORY_ENABLED=false

# Whether to compact trajectories (head+tail bounding) before distillation.
# MEMORY_COMPACT_TRAJECTORY=true

# Token budgets
# MEMORY_MAX_HIPPOCAMPUS_TOKENS=16384
# MEMORY_MAX_HIPPOCAMPUS_ITEM_TOKENS=512
# MEMORY_MAX_TRAJECTORY_TOKENS=16384
# MEMORY_MAX_QUESTION_TOKENS=8192

# LLM settings for reflection modules
# MEMORY_DISTILLER_MODEL=bedrock/converse/nvidia.nemotron-super-3-120b
# MEMORY_DISTILLER_REASONING_EFFORT=low
# MEMORY_DISTILLER_TEMPERATURE=1
# MEMORY_DISTILLER_MAX_TOKENS=64000
# MEMORY_DISTILLER_MAX_ITERS=1
# MEMORY_DISTILLER_MAX_LLM_CALLS=2

# MEMORY_CARTOGRAPHER_MODEL=bedrock/converse/nvidia.nemotron-super-3-120b
# MEMORY_CARTOGRAPHER_REASONING_EFFORT=low
# MEMORY_CARTOGRAPHER_TEMPERATURE=1
# MEMORY_CARTOGRAPHER_MAX_TOKENS=64000
# MEMORY_CARTOGRAPHER_MAX_ITERS=1
# MEMORY_CARTOGRAPHER_MAX_LLM_CALLS=2


# =============================================================================
# Cerebral (Semantic Memory)
# =============================================================================
# Cerebral activates automatically when MEMORY_ENABLED=true.
# LLM provider and credentials are derived from the model string and existing
# LLM config (e.g. bedrock uses AWS env vars, openai uses OPENAI_API_KEY).
# MEMORY_RETAIN_MODEL=bedrock/converse/nvidia.nemotron-super-3-120b
# MEMORY_CONSOLIDATION_MODEL=bedrock/converse/nvidia.nemotron-super-3-120b
# MEMORY_MENTAL_MODELS_MODEL=bedrock/converse/nvidia.nemotron-super-3-120b
# MEMORY_EMBEDDINGS_MODEL=bedrock/cohere.embed-v4:0
# MEMORY_EMBEDDINGS_MAX_INPUT_CHARS=       # null = auto per model (2048 for Bedrock Cohere v3), 0 = off
# MEMORY_EMBEDDINGS_MAX_INPUT_CHARS=       # null = auto per model (2048 for Bedrock Cohere v3), 0 = off
# MEMORY_RETAIN_CHUNK_SIZE=12288           # Chars per extraction chunk (< 64000)
# MEMORY_CONSOLIDATION_MAX_OBSERVATIONS_PER_SCOPE=100  # Per-scope observation cap (-1 = unlimited, 0 = no new observations)


# =============================================================================
# Cerebral Mental Models (Briefing Refresh)
# =============================================================================
# Mental-model refresh synthesizes briefings after consolidation.
# Falls back to prefrontal.recall.model → cerebral.retain.model → default_model.
# Only used when prefrontal.reflects > 0.
# MEMORY_MENTAL_MODELS_MODEL=              # Briefing refresh model
# MEMORY_MENTAL_MODELS_MAX_TOKENS=2048     # Briefing length
# MEMORY_MENTAL_MODELS_MIN_REFRESH_SECONDS=0  # Minimum seconds between refreshes

# =============================================================================
# Prefrontal (Semantic Recall into Agent Context)
# =============================================================================
# Reads Cerebral before each agent call (briefings + recalled facts) and gives
# RLM agents a recall_memory tool. Active per signature when memory is enabled
# and Cerebral is available. Read-only: never writes to Cerebral.
# Every recall is logged (INFO summary) and stored in the episodic `recalls` table.
#
# Both Prefrontal and briefing refreshes run at Hindsight's LOW budget with a
# doubled global cap (2 × reflects), so each gets exactly ``reflects`` iterations.
# A raw HINDSIGHT_API_REFLECT_MAX_ITERATIONS env value is used as-is (not doubled).
# MEMORY_PREFRONTAL_REFLECTS=3             # Reflect iterations; 0 = raw facts, no LLM, no briefings

# Recall settings (read-time context injection)
# MEMORY_RECALL_MODEL=                     # Reflect model; also briefings fallback unless cerebral.mental_models.model set
# MEMORY_RECALL_REACH=org                  # local | org | bank (bank crosses organisations)
# MEMORY_RECALL_MAX_TOKENS=8192            # Pre-call context budget
# MEMORY_RECALL_MAX_TOOL_TOKENS=2048       # Tool result budget
# MEMORY_RECALL_MAX_TOOL_CALLS=0           # Per agent call (0 = recall_memory tool off)

# Reflect LLM timeout/retries default to codespy's LLM_TIMEOUT / LLM_RETRIES.
# Override via HINDSIGHT_API_REFLECT_LLM_TIMEOUT / HINDSIGHT_API_REFLECT_LLM_MAX_RETRIES.


# =============================================================================
# Output Settings
# =============================================================================

# Output format: markdown or json (default: markdown)
# REVIEW_OUTPUT_FORMAT=markdown

# Enable stdout output (default: true)
# REVIEW_OUTPUT_STDOUT=true

# Post review to Git platform (GitHub PR or GitLab MR) (default: true)
# REVIEW_OUTPUT_GIT=true

# Cache directory for cloned repositories (default: ~/.cache/codespy)
# REVIEW_CACHE_DIR=/path/to/cache


# =============================================================================
# Per-Signature Configuration (override via env vars)
# =============================================================================
# Use underscore (_) between signature name and setting
# Format: REVIEW_<SIGNATURE_NAME>_<SETTING>=value
#
# Available signatures:
#   - CODE_REVIEW    (bugs, security, removed defensive code, code smells)
#   - DOC            (compares patches against documentation)
#   - SCOPE          (code scope detection)
#   - SUPPLY_CHAIN   (supply chain security analysis)
#   - SUMMARY        (PR summary generation)
#   - AUDIT          (quality assessment after reviews)
#
# Available settings per signature:
#   - ENABLED (true/false)
#   - MAX_ITERS (integer)
#   - MAX_LLM_CALLS (integer) - RLM fallback max calls
#   - MODEL (LiteLLM model string)
#   - REASONING_EFFORT (minimal|low|medium|high)
#   - TEMPERATURE (float)
#   - MAX_TOKENS (integer)
#   - MEMORY_ENABLED (true/false)

# Examples:
# REVIEW_CODE_REVIEW_ENABLED=true
# REVIEW_CODE_REVIEW_MAX_ITERS=4
# REVIEW_CODE_REVIEW_MODEL=anthropic/claude-sonnet-4-5-20250929
# REVIEW_CODE_REVIEW_REASONING_EFFORT=medium
# REVIEW_CODE_REVIEW_TEMPERATURE=1
# REVIEW_CODE_REVIEW_MAX_TOKENS=32000
# REVIEW_CODE_REVIEW_MEMORY_ENABLED=true

# REVIEW_SUPPLY_CHAIN_ENABLED=true
# REVIEW_SUPPLY_CHAIN_SCAN_UNCHANGED=false
# REVIEW_SUPPLY_CHAIN_MEMORY_ENABLED=true

# REVIEW_DOC_ENABLED=true
# REVIEW_DOC_MAX_ITERS=2
# REVIEW_DOC_MAX_LLM_CALLS=4
# REVIEW_DOC_MODEL=bedrock/converse/global.anthropic.claude-opus-5-5
# REVIEW_DOC_MEMORY_ENABLED=true

# REVIEW_SCOPE_SKIP_REFINEMENT_WHEN_CLEAN=true

# REVIEW_SCOPE_ENABLED=true
# REVIEW_SCOPE_MAX_ITERS=4
# REVIEW_SCOPE_REASONING_EFFORT=low
# REVIEW_SCOPE_MAX_TOKENS=32000
# REVIEW_SCOPE_MEMORY_ENABLED=true

# REVIEW_SUMMARY_ENABLED=true
# REVIEW_SUMMARY_MAX_ITERS=1
# REVIEW_SUMMARY_MAX_LLM_CALLS=2
# REVIEW_SUMMARY_MODEL=bedrock/converse/nvidia.nemotron-super-3-120b
# REVIEW_SUMMARY_MEMORY_ENABLED=true

# REVIEW_AUDIT_ENABLED=true
# REVIEW_AUDIT_MAX_ITERS=1
# REVIEW_AUDIT_MEMORY_ENABLED=true
